<style>
  table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 1rem;
    background-color: #fff;
  }

  th,
  td {
    border: 1px solid #ccc;
    padding: 0.75rem;
    text-align: left;
    vertical-align: middle;
  }

  th {
    background-color: #f5f5f5;
    font-weight: bold;
  }

  tbody tr:nth-child(even) {
    background-color: #fafafa;
  }

  td[rowspan] {
    font-weight: bold;
  }

  td span {
    display: inline-block;
    border: 1px solid #ccc;
    border-radius: 3px;
    padding: 0.1rem 0.3rem;
    font-size: 0.85rem;
    background-color: #f8f8f8;
    color: #333;
    margin: 0 0.2rem 0.2rem 0;
  }
</style>

# 職務経歴書

## 基本情報

<table>
  <tbody>
    <tr>
      <th>名前</th>
      <td><%= profile.name %></td>
    </tr>
    <tr>
      <th>専門領域</th>
      <td><%= profile.specialty %></td>
    </tr>
    <tr>
      <th>GitHub</th>
      <td><a href="<%= profile.github %>" target="_blank"><%= profile.github %></a></td>
    </tr>
  </tbody>
</table>

## PR

<p>
<%= pr.text.trim() %>
</p>

## 職務経歴

<table>
  <thead>
    <tr>
      <th>期間</th>
      <th>会社名</th>
    </tr>
  </thead>
  <tbody>
<% career.entries.forEach(function(entry) { -%>
    <tr>
      <td><%= entry.period %></td>
      <td><%= entry.company %></td>
    </tr>
<% }); -%>
  </tbody>
</table>

## 最終学歴

<table>
  <thead>
    <tr>
      <th>期間</th>
      <th>学校名</th>
      <th>学部・学科</th>
    </tr>
  </thead>
  <tbody>
<% education.entries.forEach(function(entry) { -%>
    <tr>
      <td><%= entry.period %></td>
      <td><%= entry.school %></td>
      <td><%= entry.faculty %></td>
    </tr>
<% }); -%>
  </tbody>
</table>

<% education.entries.forEach(function(entry) { -%>
<p>
<%= entry.description.trim() %>
</p>
<% }); -%>

## スキルセット

<table>
  <thead>
    <tr>
      <th></th>
      <th>環境</th>
      <th>実務経験</th>
      <th>実務以外の経験</th>
    </tr>
  </thead>
  <tbody>
<% skills.categories.forEach(function(cat) { -%>
<% cat.items.forEach(function(item, i) { -%>
    <tr>
<% if (i === 0) { -%>
      <td rowspan="<%= cat.items.length %>"><%= cat.name %></td>
<% } -%>
      <td><%= item.env %></td>
      <td><%= item.work %></td>
      <td><%= item.personal %></td>
    </tr>
<% }); -%>
<% }); -%>
  </tbody>
</table>

## 開発経歴

<%
const companyGroups = [
  { label: '業務委託・副業', companies: ['業務委託'] },
  { label: '株式会社MPX', companies: ['株式会社MPX'] },
  { label: '株式会社レコチョク', companies: ['株式会社レコチョク'] }
];
companyGroups.forEach(function(group) {
  const groupProjects = projects.filter(p => group.companies.includes(p.company));
  if (groupProjects.length === 0) return;
-%>

### <%= group.label %>

<table>
  <thead>
    <tr>
      <th>No</th>
      <th>プロジェクト名</th>
      <th>期間</th>
    </tr>
  </thead>
  <tbody>
<% groupProjects.forEach(function(project) { -%>
    <tr>
      <td><%= parseInt(project.id) %></td>
      <td><a href="#project-<%= project.id %>"><%= project.name %></a></td>
      <td><%= project.period %>/<%= project.duration %></td>
    </tr>
<% }); -%>
  </tbody>
</table>

<% }); -%>

## 各プロジェクト詳細

<% projects.forEach(function(project) { -%>

### <a name="project-<%= project.id %>"></a><%= project.name %>

<table>
  <thead>
    <tr>
      <th>カテゴリ</th>
      <th>担当工程</th>
      <th>職種・役割</th>
      <th>使用技術</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>
<% project.category.forEach(function(c) { -%>
        <span><%= c %></span>
<% }); -%>
      </td>
      <td>
<% project.phases.forEach(function(p) { -%>
        <span><%= p %></span>
<% }); -%>
      </td>
      <td>
<% project.roles.forEach(function(r) { -%>
        <span><%= r %></span>
<% }); -%>
      </td>
      <td>
<% project.technologies.forEach(function(t) { -%>
        <span><%= t %></span>
<% }); -%>
      </td>
    </tr>
  </tbody>
</table>

<% if (project.team && project.team.size > 0) { -%>
#### チーム情報

チーム人数：<%= project.team.size %>名<% if (project.team.details) { %>（<%= project.team.details %>）<% } %>
<% if (project.team.role) { -%>
役割：<%= project.team.role %>
<% } -%>
<% } -%>

#### 開発・実装内容

<% if (project.overview && project.overview.trim()) { -%>
##### 【概要】

<%= project.overview.trim() %>

<% } -%>
<% if (project.details && project.details.trim()) { -%>
##### 【内容】

<%= project.details.trim() %>

<% } -%>
<% if (project.challenges && project.challenges.trim()) { -%>
##### 【課題・問題点】

<%= project.challenges.trim() %>

<% } -%>
<% if (project.approach && project.approach.trim()) { -%>
##### 【工夫・思考プロセス】

<%= project.approach.trim() %>

<% } -%>
<% if (project.results && project.results.trim()) { -%>
##### 【成果】

<%= project.results.trim() %>

<% } -%>
<% if (project.tech_summary && project.tech_summary.trim()) { -%>
#### 使用技術（まとめ）

<%= project.tech_summary.trim() %>

<% } -%>

[↑ 開発経歴に戻る](#開発経歴)

<% }); -%>
