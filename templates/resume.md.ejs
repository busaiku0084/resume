## 開発経歴

<%
const companyOrder = career.entries.map(e => e.company);
const seen = new Set();
const companyGroups = companyOrder.filter(c => { if (seen.has(c)) return false; seen.add(c); return true; });
companyGroups.forEach(function(company) {
  const groupProjects = projects.filter(p => p.company === company);
  if (groupProjects.length === 0) return;
-%>

### <%= company %>

<% groupProjects.forEach(function(project) { -%>
<div class="html-content" data-project="project<%= project.id %>"></div>
<% }); -%>
<% }); -%>

## スキルレベル

<table>
  <thead>
    <tr>
      <th></th>
      <th>環境</th>
      <th>実務経験</th>
      <th>実務以外の経験</th>
    </tr>
  </thead>
  <tbody>
<% skills.categories.forEach(function(cat) { -%>
<% cat.items.forEach(function(item, i) { -%>
    <tr>
<% if (i === 0) { -%>
      <td rowspan="<%= cat.items.length %>"><%= cat.name %></td>
<% } -%>
      <td><%= item.env %></td>
      <td><%= item.work %></td>
      <td><%= item.personal %></td>
    </tr>
<% }); -%>
<% }); -%>
  </tbody>
</table>

