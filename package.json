{
  "name": "resume",
  "version": "2.0.0",
  "description": "YAML駆動の職務経歴書管理システム",
  "scripts": {
    "build": "node scripts/build.js --public",
    "build:private": "node scripts/build.js",
    "build:pdf": "node scripts/build-pdf.js",
    "build:pdf:public": "node scripts/build-pdf.js --public",
    "build:draft": "node scripts/build-draft.js",
    "build:draft:public": "node scripts/build-draft.js --public",
    "build:wantedly": "node scripts/build-wantedly.js",
    "build:wantedly:public": "node scripts/build-wantedly.js --public",
    "dev": "npm run build && cd docs && browser-sync start --server --files '**/*'",
    "dev:private": "npm run build:private && cd docs && browser-sync start --server --files '**/*'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "browser-sync": "^3.0.3",
    "ejs": "^3.1.10",
    "js-yaml": "^4.1.0",
    "md-to-pdf": "^5.2.4",
    "prettier": "^3.4.2"
  }
}
